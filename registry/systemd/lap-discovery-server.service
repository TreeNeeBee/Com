[Unit]
Description=LightAP FastDDS Discovery Server
Documentation=man:fastdds(1)
After=network.target
Before=lap-registry-qm.socket lap-registry-asil.socket

# If Discovery Server fails, registries still work (local-only mode)
# Reference: SERVICE_DISCOVERY_ARCHITECTURE §2.0.6 (Fault Recovery)

[Service]
Type=simple

# Environment defaults (overridden by EnvironmentFile)
Environment=DS_LISTEN_ADDR=0.0.0.0
Environment=DS_PORT=11811
Environment=DS_SERVER_ID=0
Environment=DS_CONFIG_DIR=/etc/lap/discovery

EnvironmentFile=-/etc/lap/discovery/fastdds_ds_env.conf

ExecStartPre=/bin/mkdir -p ${DS_CONFIG_DIR}
ExecStart=/usr/bin/fastdds discovery \
    -i ${DS_SERVER_ID} \
    -l ${DS_LISTEN_ADDR} \
    -p ${DS_PORT} \
    -x ${DS_CONFIG_DIR}/fastdds_ds_server.xml

Restart=on-failure
RestartSec=3s
WatchdogSec=30s

# Resource limits (§5.4.2 reference: 250M max for SD Proxy)
# Discovery Server is lighter: 100M ceiling
MemoryMax=100M
MemoryHigh=80M
CPUQuota=10%
Nice=-5

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/lap

StandardOutput=journal
StandardError=journal
SyslogIdentifier=lap-discovery-server

[Install]
WantedBy=multi-user.target
