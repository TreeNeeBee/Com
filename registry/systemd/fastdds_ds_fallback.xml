<?xml version="1.0" encoding="UTF-8" ?>
<!--
  LightAP - FastDDS PDP/EDP Fallback Configuration
  ================================================================
  Reference: SERVICE_DISCOVERY_ARCHITECTURE §2.0.6 (Fault Recovery)
  
  This profile is activated when the centralized Discovery Server is
  unavailable. It uses the standard SIMPLE discovery protocol with
  multicast PDP and unicast EDP (standard DDS behavior).
  
  Degradation path:
    Discovery Server (CLIENT mode) → UNREACHABLE
      → Monitor detects failure (3 consecutive health-check failures)
      → Switch FASTDDS_DEFAULT_PROFILES_FILE to this fallback XML
      → Restart SD Proxy with standard PDP/EDP multicast discovery
      → Services reachable via multicast (higher latency, more bandwidth)
  
  Trade-offs vs Discovery Server mode:
    - ✅ No single point of failure (decentralized)
    - ⚠️ Higher discovery latency (10-50ms vs <5ms)
    - ⚠️ More network bandwidth (multicast announcements)
    - ⚠️ Less predictable in large networks (>10 participants)
-->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">

    <!-- ============================================================ -->
    <!-- Transport: enable multicast for PDP announcements            -->
    <!-- ============================================================ -->
    <transport_descriptors>
        <transport_descriptor>
            <transport_id>udp_transport</transport_id>
            <type>UDPv4</type>
            <sendBufferSize>1048576</sendBufferSize>
            <receiveBufferSize>1048576</receiveBufferSize>
            <non_blocking_send>true</non_blocking_send>
        </transport_descriptor>
    </transport_descriptors>

    <!-- ============================================================ -->
    <!-- SIMPLE discovery (standard PDP/EDP multicast)                -->
    <!-- ============================================================ -->
    <profiles>
        <participant profile_name="lap_pdp_fallback" is_default_profile="true">
            <rtps>
                <builtin>
                    <discovery_config>
                        <!-- Standard multicast-based discovery -->
                        <discoveryProtocol>SIMPLE</discoveryProtocol>

                        <!-- PDP announcement period -->
                        <leaseDuration>
                            <sec>20</sec>
                            <nanosec>0</nanosec>
                        </leaseDuration>

                        <leaseAnnouncement>
                            <sec>3</sec>
                            <nanosec>0</nanosec>
                        </leaseAnnouncement>
                    </discovery_config>

                    <!-- Multicast locator for PDP -->
                    <metatrafficMulticastLocatorList>
                        <locator>
                            <udpv4>
                                <address>239.255.0.1</address>
                                <port>7400</port>
                            </udpv4>
                        </locator>
                    </metatrafficMulticastLocatorList>
                </builtin>

                <useBuiltinTransports>false</useBuiltinTransports>
                <userTransports>
                    <transport_id>udp_transport</transport_id>
                </userTransports>
            </rtps>
        </participant>
    </profiles>

</dds>
