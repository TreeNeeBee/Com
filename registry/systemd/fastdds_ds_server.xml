<?xml version="1.0" encoding="UTF-8" ?>
<!--
  LightAP - FastDDS Discovery Server Configuration (Server-Side)
  ================================================================
  Reference: SERVICE_DISCOVERY_ARCHITECTURE §5.2.3, §5.4.1
  
  This profile configures the FastDDS Discovery Server that acts as the
  centralized service discovery hub for cross-ECU communication.
  
  Deployment model (from architecture doc §5.2.3):
    ┌──── ECU_Gateway (Discovery Server) ────┐
    │  fastdds discovery -x this_file.xml    │
    │  Listens on 0.0.0.0:11811 (UDP)        │
    └───────────────────┬────────────────────┘
              ┌─────────┴─────────┐
        ECU_ADAS (CLIENT)   ECU_Cockpit (CLIENT)
  
  Usage:
    fastdds discovery -x fastdds_ds_server.xml
    (or via systemd: lap-discovery-server.service)
-->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">

    <!-- ============================================================ -->
    <!-- Transport: UDP (automotive ethernet, low-latency)            -->
    <!-- ============================================================ -->
    <transport_descriptors>
        <transport_descriptor>
            <transport_id>udp_transport</transport_id>
            <type>UDPv4</type>
            <sendBufferSize>1048576</sendBufferSize>    <!-- 1 MB -->
            <receiveBufferSize>1048576</receiveBufferSize>
            <non_blocking_send>true</non_blocking_send>
        </transport_descriptor>
    </transport_descriptors>

    <!-- ============================================================ -->
    <!-- Discovery Server Participant Profile                         -->
    <!-- ============================================================ -->
    <profiles>
        <participant profile_name="lap_discovery_server" is_default_profile="true">
            <rtps>
                <!-- Server GUID prefix: derived from server-id 0 -->
                <prefix>44.53.00.5f.45.50.52.4f.53.49.4d.41</prefix>

                <!-- Builtin discovery configuration -->
                <builtin>
                    <discovery_config>
                        <discoveryProtocol>SERVER</discoveryProtocol>

                        <!-- Listening locator for client connections -->
                        <metatrafficUnicastLocatorList>
                            <locator>
                                <udpv4>
                                    <address>0.0.0.0</address>
                                    <port>11811</port>
                                </udpv4>
                            </locator>
                        </metatrafficUnicastLocatorList>

                        <!-- Lease duration: how long before a silent client
                             is considered dead (seconds) -->
                        <leaseDuration>
                            <sec>20</sec>
                            <nanosec>0</nanosec>
                        </leaseDuration>

                        <!-- Announcement period for discovery info -->
                        <discoveryServer_client_syncperiod>
                            <sec>1</sec>
                            <nanosec>0</nanosec>
                        </discoveryServer_client_syncperiod>
                    </discovery_config>
                </builtin>

                <!-- Use only our configured transport -->
                <useBuiltinTransports>false</useBuiltinTransports>
                <userTransports>
                    <transport_id>udp_transport</transport_id>
                </userTransports>
            </rtps>
        </participant>
    </profiles>

</dds>
