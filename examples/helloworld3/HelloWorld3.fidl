/**
 * @file    HelloWorld3.fidl
 * @brief   SensorFusion service — DDS-only binding, comprehensive FIDL coverage
 * @version 1.0
 * @date    2026-03-02
 *
 * Demonstrates a DDS-only AUTOSAR AP development flow covering:
 *
 *   TypeCollection : 3 enumerations, 4 structs, 2 typedefs (scalar + array)
 *   Methods        : sync (single/multi-arg), fire-and-forget, async-friendly
 *   Events         : 3 broadcasts (enum, struct, multi-arg, binary)
 *   Fields         : readonly, readwrite, readonly+notify, readwrite+notify (5 total)
 *
 * Transport: DDS only (eProsima Fast DDS)
 *   - IDL + fastddsgen PubSubTypes generated by lap_sidl_gen --binding dds
 *   - DdsAdapter + QoS XML paired automatically
 *
 * Standard development flow:
 *   1. Define service in .fidl
 *   2. lap_sidl_gen --binding dds → gen/  (Types, Proxy, Skeleton, IDL,
 *      DdsAdapter, ServerApp, ClientApp, QoS XML, fastddsgen PubSubTypes)
 *   3. Implement server/client using generated App framework
 *   4. Build and test
 */
package lap.examples.helloworld3

typeCollection SensorTypes {

    enumeration SensorType {
        LIDAR       = 0
        CAMERA      = 1
        RADAR       = 2
        ULTRASONIC  = 3
        IMU         = 4
    }

    enumeration AlertLevel {
        NONE        = 0
        INFO        = 1
        WARNING     = 2
        CRITICAL    = 3
    }

    enumeration DeviceState {
        OFFLINE         = 0
        INITIALIZING    = 1
        ONLINE          = 2
        ERROR           = 3
        MAINTENANCE     = 4
    }

    struct GeoPosition {
        Double latitude
        Double longitude
        Double altitude
    }

    struct SensorReading {
        UInt32      sensorId
        Double      value
        UInt64      timestamp
        Boolean     valid
    }

    struct AlertInfo {
        AlertLevel  level
        String      source
        String      message
        UInt64      timestamp
    }

    struct DiagnosticReport {
        UInt32      deviceId
        DeviceState state
        UInt32      errorCount
        Double      uptime
        String      firmwareVersion
    }

    typedef Angle is Double

    typedef RawPayload is UInt8[]
}

interface SensorFusionService {
    version { major 1 minor 0 }

    // =================================================================
    // Methods — comprehensive patterns
    // =================================================================

    /** Sync single-arg request/response */
    method GetSensorReading {
        in  { UInt32 sensorId }
        out { SensorTypes.SensorReading reading }
    }

    /** Sync multi-arg in/out — calibration with status feedback */
    method CalibrateDevice {
        in  { UInt32 deviceId
              Double offset }
        out { Boolean success
              String  message }
    }

    /** Fire-and-forget — telemetry ingestion (no response) */
    method SubmitTelemetry fireAndForget {
        in  { UInt32 channelId
              ByteArray payload }
    }

    /** Async-friendly — hash computation over raw payload */
    method ComputeDigest {
        in  { ByteArray data
              String    algorithm }
        out { UInt64 digest }
    }

    /** Sync — returns complex struct */
    method GetDiagnostics {
        in  { UInt32 deviceId }
        out { SensorTypes.DiagnosticReport report }
    }

    // =================================================================
    // Events (broadcasts) — various payload shapes
    // =================================================================

    /** Struct event — alert notification */
    broadcast SensorAlert {
        out { SensorTypes.AlertInfo alert }
    }

    /** Multi-arg event — position + heading + speed */
    broadcast PositionUpdate {
        out { SensorTypes.GeoPosition position
              SensorTypes.Angle       heading
              Double                  speed }
    }

    /** Binary event — raw telemetry stream */
    broadcast RawTelemetry {
        out { UInt32    channelId
              ByteArray payload }
    }

    // =================================================================
    // Fields (attributes) — all 4 combinations
    // =================================================================

    /** readonly, no notify — static sensor count */
    attribute UInt32 ActiveSensorCount readonly

    /** readwrite, no notify — mutable system label */
    attribute String SystemName

    /** readonly + notify — server pushes rate changes */
    attribute Double FusionRate readonly notify

    /** readwrite + notify — position with change notification */
    attribute SensorTypes.GeoPosition CurrentPosition notify

    /** readwrite + notify — enum state with notification */
    attribute SensorTypes.DeviceState SystemState notify
}
